{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "login",
        "analysis",
        "report_delete",
        "report_delete_all",
        "user_delete",
        "data_export",
        "profile_update"
      ]
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "details": {
      "type": "string"
    }
  },
  "required": [
    "action"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}